{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "MAVEN_OPTS='-Xms64m -Xmx256m' mvn clean package -DskipTests -q"
  },
  "deploy": {
    "startCommand": "java -Xms64m -Xmx350m -XX:+UseSerialGC -Dspring.profiles.active=prod -jar target/driveestate-1.0.0.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
